# ==============================================================================
# CREATIVE RESEARCH WORKBENCH (CRW) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# BẢN MẪU BIẾN MÔI TRƯỜNG AN TOÀN — KHÔNG LƯU THÔNG TIN XÁC THỰC HOẶC SECRET THẬT
# Sao chép file này thành .env trên máy trạm hoặc máy chủ:
#   cp .env.example .env && chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# DATABASE_URL:
#   - Bắt buộc: CÓ
#   - Nơi sử dụng: backend/src/app/core/config.py, backend/entrypoint.sh,
#                  backend/src/app/infrastructure/migrations/runner.py,
#                  backend/src/app/api/v1/endpoints/sessions.py
#   - Lưu ý ngữ cảnh kết nối:
#     * Chạy trên Docker stack (mặc định trong docker-compose.yml):
#       DATABASE_URL=postgresql+asyncpg://crw_user:crw_password@db:5432/crw_dev
#     * Chạy trực tiếp trên máy trạm (Local Host kết nối container DB qua port 5433):
#       DATABASE_URL=postgresql+asyncpg://crw_user:crw_password@localhost:5433/crw_dev
#       (Hoặc dùng driver sync: postgresql://crw_user:crw_password@localhost:5433/crw_dev)
DATABASE_URL=postgresql+asyncpg://crw_user:crw_password@localhost:5433/crw_dev

# ------------------------------------------------------------------------------
# 2. RUNTIME ENVIRONMENT & CORS SECURITY
# ------------------------------------------------------------------------------
# ENVIRONMENT:
#   - Bắt buộc: KHÔNG (Mặc định: development)
#   - Nơi sử dụng: docker-compose.yml, scripts vận hành
#   - Giá trị hợp lệ: development | production | test
ENVIRONMENT=development

# ALLOWED_ORIGINS:
#   - Bắt buộc: KHÔNG (Mặc định trong config.py: ["http://localhost:5173", "http://localhost:3000"])
#   - Nơi sử dụng: backend/src/app/core/config.py -> backend/src/app/main.py (CORSMiddleware)
#   - Định dạng: Chuỗi JSON array hợp lệ chứa các origin được phép gọi API
#   - Trong Docker Compose: ["http://localhost:3011", "http://127.0.0.1:3011", "http://localhost:8000", "http://localhost:3000"]
ALLOWED_ORIGINS='["http://localhost:3011", "http://127.0.0.1:3011", "http://localhost:8000", "http://localhost:3000"]'

# ------------------------------------------------------------------------------
# 3. FRONTEND WEB CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL:
#   - Bắt buộc: CÓ (phía Client-side Browser)
#   - Nơi sử dụng: apps/web/lib/api-client.ts, apps/web/Dockerfile (Build ARG), docker-compose.yml
#   - Mặc định an toàn: http://localhost:8000 (URL của backend API mà trình duyệt trên host gọi tới)
NEXT_PUBLIC_API_URL=http://localhost:8000

# API_BASE_URL:
#   - Bắt buộc: KHÔNG (chỉ dùng khi container Next.js rewrite request nội bộ sang backend)
#   - Nơi sử dụng: apps/web/next.config.mjs, docker-compose.yml
#   - Môi trường áp dụng: Docker network (http://api:8000) hoặc Local host dev (http://localhost:8000)
API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. AI PROVIDERS & EXTENSIBLE LLM/EMBEDDING
# ------------------------------------------------------------------------------
# LLM_PROVIDER:
#   - Bắt buộc: KHÔNG (Mặc định an toàn: mock)
#   - Nơi sử dụng: backend/src/app/core/config.py, backend/src/app/services/llm_client.py,
#                  backend/src/app/api/v1/endpoints/system.py (/api/v1/system/ai-status)
#   - Giá trị hợp lệ: mock | openai | ollama
LLM_PROVIDER=mock

# EMBEDDING_PROVIDER:
#   - Bắt buộc: KHÔNG (Mặc định an toàn: mock)
#   - Nơi sử dụng: backend/src/app/core/config.py, backend/src/app/services/embedding_client.py,
#                  backend/src/app/api/v1/endpoints/system.py (/api/v1/system/ai-status)
#   - Giá trị hợp lệ: mock | openai | ollama
EMBEDDING_PROVIDER=mock

# OPENAI_API_KEY:
#   - Bắt buộc: KHÔNG (Chỉ bắt buộc khi LLM_PROVIDER=openai hoặc EMBEDDING_PROVIDER=openai)
#   - Nơi sử dụng: backend/src/app/services/llm_client.py, backend/src/app/services/embedding_client.py
#   - Lưu ý: Dùng placeholder an toàn, không commit khóa thật
OPENAI_API_KEY=sk-proj-placeholder-not-real-key

# OLLAMA_BASE_URL:
#   - Bắt buộc: KHÔNG (Chỉ dùng khi LLM_PROVIDER=ollama hoặc EMBEDDING_PROVIDER=ollama)
#   - Nơi sử dụng: backend/src/app/core/config.py, backend/src/app/services/llm_client.py,
#                  backend/src/app/services/embedding_client.py
#   - Local host: http://localhost:11434
#   - Bên trong Docker container kết nối host: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Tùy chỉnh Model AI (Tùy chọn):
# LLM_MODEL_NAME=gpt-4o-mini
# EMBEDDING_MODEL_NAME=text-embedding-3-small
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cấu hình Resilience & Timeout AI:
# LLM_TIMEOUT_SECONDS: Timeout tối đa cho mỗi cuộc gọi LLM (Mặc định: 10.0 giây)
# LLM_MAX_RETRIES: Số lần thử lại tối đa trước khi fallback hoặc báo lỗi (Mặc định: 2)
LLM_TIMEOUT_SECONDS=10.0
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 5. IN-PROCESS CACHING LAYER (Phase 12.3)
# ------------------------------------------------------------------------------
# ENABLE_CACHE:
#   - Bắt buộc: KHÔNG (Mặc định: true)
#   - Nơi sử dụng: backend/src/app/core/config.py, backend/src/app/services/cache_service.py
ENABLE_CACHE=true

# CACHE_DEFAULT_TTL:
#   - Bắt buộc: KHÔNG (Mặc định: 300 giây)
#   - Nơi sử dụng: backend/src/app/core/config.py
CACHE_DEFAULT_TTL=300
